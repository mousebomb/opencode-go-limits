# 复制本文件为 .env 并填写真实值（.env 已被 gitignore，不会入库）
# 必填：
DEPLOY_HOST=你的ECS公网IP
DEPLOY_PORT=22
DEPLOY_USER=root
DEPLOY_KEY_PATH=/Users/rhett/.ssh/id_rsa
DEPLOY_KEY_PASSPHRASE=你的SSH密钥口令
DEPLOY_TARGET_DIR=/www/wwwroot/mousebomb.org/opencode-go-limits
# 可选：
#   DEPLOY_FILES=index.html,goat-limits.html   指定要上传的页面（默认上传项目根目录全部 *.html）
# 说明：
#   - DEPLOY_TARGET_DIR 为线上页面所在目录（nginx 站点目录）
#   - DEPLOY_KEY_PASSPHRASE 无口令可留空
#   - 未配置 .env 时，git push 自动跳过部署（fork 者不受影响）
